# Copy to .env.local for dev. In prod these live in Railway / Doppler.

# Where the SQLite file lives (Railway: mount a volume and point here)
LINK_HUB_DB=./data/link-hub.sqlite

# Secret used to sign magic-link tokens AND session cookies (HMAC). 32+ random bytes.
LINK_HUB_SECRET=dev-only-change-me-to-a-long-random-string

# Shared secret LPOS must present on POST /api/ingest (header: x-lpos-token)
LPOS_INGEST_TOKEN=dev-only-change-me-too

# Public origin of this app (used to build magic-link URLs in emails)
NEXT_PUBLIC_APP_ORIGIN=http://localhost:4310

# --- email (magic link) ---
# Not wired yet. In dev the sign-in link is printed to the server console.
# TODO: plug in the real sender (same one LPOS uses).
